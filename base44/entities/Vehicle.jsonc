{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "fleet_number": {
      "type": "string",
      "description": "Numer taborowy pojazdu, np. BUS01"
    },
    "model": {
      "type": "string",
      "description": "Model pojazdu, np. Solaris Urbino 18"
    },
    "image_url": {
      "type": "string",
      "description": "Zdj\u0119cie lub ikona pojazdu (JPG/PNG)"
    },
    "satisfaction": {
      "type": "number",
      "description": "Zadowolenie autobusu w procentach. Poni\u017cej 40% autobus mo\u017ce uciec z trasy \u2014 im ni\u017cej, tym wi\u0119ksza szansa.",
      "default": 100
    },
    "fatigue": {
      "type": "number",
      "description": "Zm\u0119czenie autobusu w procentach. Ro\u015bnie w ci\u0105gu dnia; od 80% autobus zasypia na p\u0119tli i stoi do czasu wys\u0142ania do SPA.",
      "default": 0
    },
    "spa": {
      "type": "boolean",
      "description": "Autobus odes\u0142any do spa w zajezdni \u2014 stoi, odpoczywa i ma status \u015aPI.",
      "default": false
    }
  },
  "required": [
    "fleet_number"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
