{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "fleet_number": {
      "type": "string",
      "description": "Numer taborowy pojazdu, np. BUS01"
    },
    "kind": {
      "type": "string",
      "description": "Rodzaj pojazdu: autobus albo tramwaj",
      "enum": [
        "bus",
        "tram"
      ],
      "enumColors": [
        "blue",
        "gray"
      ],
      "default": "bus"
    },
    "model": {
      "type": "string",
      "description": "Model pojazdu, np. Solaris Urbino 18"
    },
    "image_url": {
      "type": "string",
      "description": "Zdj\u0119cie lub ikona pojazdu (JPG/PNG)"
    },
    "satisfaction": {
      "type": "number",
      "description": "Zadowolenie pojazdu w procentach. Spada samo w ci\u0105gu dnia; poni\u017cej 40% pojazd mo\u017ce uciec z trasy.",
      "default": 100
    },
    "fatigue": {
      "type": "number",
      "description": "Zm\u0119czenie pojazdu w procentach. Ro\u015bnie samo w ci\u0105gu dnia; od 80% zasypia na p\u0119tli do czasu u\u0142o\u017cenia go do spania w zajezdni.",
      "default": 0
    },
    "depot_sleep": {
      "type": "boolean",
      "description": "Pojazd u\u0142o\u017cony do spania w zajezdni \u2014 stoi, odpoczywa i ma status \u015aPI.",
      "default": false
    }
  },
  "required": [
    "fleet_number"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
