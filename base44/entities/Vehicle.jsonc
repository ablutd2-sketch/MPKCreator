{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "fleet_number": {
      "type": "string",
      "description": "Numer taborowy pojazdu, np. BUS01"
    },
    "model": {
      "type": "string",
      "description": "Model pojazdu, np. Solaris Urbino 18"
    },
    "image_url": {
      "type": "string",
      "description": "Zdj\u0119cie lub ikona pojazdu (JPG/PNG)"
    }
  },
  "required": [
    "fleet_number"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
